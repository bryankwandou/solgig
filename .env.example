DATABASE_URL=
SESSION_SECRET=
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
NEXT_PUBLIC_SOLANA_NETWORK=mainnet-beta
NEXT_PUBLIC_PLATFORM_TREASURY=
NEXT_PUBLIC_PLATFORM_FEE_BPS=250
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional custodial escrow for service orders: base58 secret key of the
# platform escrow wallet. When set, service payments are held here and
# released to the seller once the buyer marks the order complete.
ESCROW_SECRET_KEY=

# x402 / USDC (optional). Without USDC_PER_SOL the SOL/USD rate is read from
# the Jupiter price API; if that fails, USDC is simply not offered.
# USDC_PER_SOL=150
# USDC_MINT=   # defaults to the canonical USDC mint for NEXT_PUBLIC_SOLANA_NETWORK
